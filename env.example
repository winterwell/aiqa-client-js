# Copy this file to .env (if you use .env) or otherwise load these environment variables into your runtime environment.
# The url where our API server listens
AIQA_SERVER_URL=http://localhost:4318
# AIQA_SERVER_URL=https://aiqa.winterwell.com
# Your organisation ID within AIQA
AIQA_ORGANISATION_ID=
# The API key to use
AIQA_API_KEY=
# Optional component tag to add to all spans (e.g., "mynamespace.mysystem")
# This allows you to filter by which component/system generated the spans - e.g. in the AIQA Traces view.
AIQA_COMPONENT_TAG=

# Fraction of traces to sample, 0-1. Defaults to 1 (trace everything).
AIQA_SAMPLING_RATE=1
# Service name reported on spans. OTEL_SERVICE_NAME wins over this if both are set.
AIQA_SERVICE_NAME=

# Browsers, web workers and Chrome MV3 extensions have no environment to read these from.
# Use aiqa-client/browser and pass them to initTracing({ apiKey, serverUrl, ... }) - see README.
